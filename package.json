{
  "name": "giftiger",
  "version": "1.0.0",
  "description": "Local-first browser video editor powered by WebAssembly and native WebCodecs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:svelte": "svelte-check",
    "check": "vitest run && svelte-check && vite build"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "lucide": "^1.28.0",
    "mediabunny": "1.44.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
